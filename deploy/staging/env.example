# /etc/i-wish-i-knew/env — shared by API and worker systemd units.
# Literal KEY=VALUE lines only; no quotes, export, or shell expansion. Do not
# source this file. Keep mode 0640 root:root. Real values live out-of-band;
# record secret LOCATIONS only in STATUS.md (.verity/deploy-access.README.md).

# deploy.sh replaces this with tag@sha256:<64 hex> only after migration succeeds.
# Leave the placeholder for a first deployment; never start units with it.
IWIK_IMAGE_TAG=v0.0.0-placeholder
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://iwik:CHANGE_ME@127.0.0.1:5432/iwik
# Required: replace with 32 random bytes encoded as 64 hex characters.
IWIK_KEK=CHANGE_ME_64_HEX_CHARACTERS

# All SIX flags off. INTAKE defaults on only outside production; the other
# five default off everywhere. See README.md for an explicit synthetic demo.
IWIK_FEATURE_INTAKE=off
IWIK_FEATURE_ENROLLMENT=off
IWIK_FEATURE_DEDUPE=off
IWIK_FEATURE_COOPERATIVE_QUERY=off
IWIK_FEATURE_CHALLENGE=off
IWIK_FEATURE_WITHDRAWAL=off

# Set a generated operator token (at least 16 characters) before enrollment or
# challenge administration. Empty disables operator authentication.
IWIK_OPERATOR_TOKEN=
# Set to the actual browser-reachable HTTPS origin (no path) for invite URLs.
# Production-mode session/CSRF cookies are Secure: remote HTTP cannot enroll
# or sign in. Keep HOST on loopback behind a tailnet-only HTTPS reverse proxy.
# Empty gives path-only invite URLs; HOST is the bind address, not this origin.
IWIK_PUBLIC_URL=
# 0 until a proxy is configured; one trusted reverse proxy = 1. Only trust
# proxy headers when clients cannot reach the backend directly.
IWIK_TRUST_PROXY=0

# Optional legacy pilot seed: leave all empty for console enrollment. Org,
# token (>=16 chars), and Ed25519 public key must be supplied together.
# Public key: raw 32 bytes as base64 (single line). Node ID: optional ULID.
IWIK_SEED_ORG=
IWIK_SEED_NODE_TOKEN=
IWIK_SEED_NODE_PUBKEY=
IWIK_SEED_NODE_ID=

# Defaults in packages/service/src/config.ts. Interval and TTLs in milliseconds.
IWIK_WORKER_INTERVAL_MS=5000
IWIK_INVITE_TTL_MS=604800000
IWIK_PREVIEW_TTL_MS=3600000
IWIK_QUERY_COHORT_CAP=500
IWIK_MAX_STRING_LENGTH=1024
IWIK_SECRET_PATTERNS=[]
IWIK_PACKS_DIR=/app/packs
IWIK_LOG_LEVEL=info
