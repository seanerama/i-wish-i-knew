<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.product %></title>
    <%~ include('_style') %>
  </head>
  <body>
    <header>
      <h1><%= it.product %></h1>
      <p class="tagline">A confidential evidence cooperative for measurable technical systems.</p>
    </header>

    <p class="trust" id="trust-boundary"><%= it.trust_statement %></p>

    <section aria-labelledby="service-heading">
      <h2 id="service-heading">Service</h2>
      <dl>
        <dt>Evidence revision</dt>
        <dd id="evidence-revision"><%= it.evidence_revision %></dd>
        <dt>Intake</dt>
        <dd id="intake-state"><%= it.intake_enabled ? 'enabled' : 'disabled (IWIK_FEATURE_INTAKE=off)' %></dd>
        <dt>Enrollment</dt>
        <dd id="enrollment-state"><%= it.enrollment_enabled ? 'enabled' : 'disabled (IWIK_FEATURE_ENROLLMENT=off)' %></dd>
        <dt>Withdrawal</dt>
        <dd id="withdrawal-state"><%= it.withdrawal_enabled ? 'enabled' : 'disabled (IWIK_FEATURE_WITHDRAWAL=off)' %></dd>
        <dt>Dedupe</dt>
        <dd id="dedupe-state"><%= it.dedupe_enabled ? 'enabled' : 'disabled (IWIK_FEATURE_DEDUPE=off)' %></dd>
        <dt>Cooperative query</dt>
        <dd id="cooperative-query-state"><%= it.cooperative_query_enabled ? 'enabled' : 'disabled (IWIK_FEATURE_COOPERATIVE_QUERY=off)' %></dd>
        <dt>Challenge ledger</dt>
        <dd id="challenge-state"><%= it.challenge_enabled ? 'enabled' : 'disabled (IWIK_FEATURE_CHALLENGE=off)' %></dd>
        <dt>Accepted protocols</dt>
        <dd id="protocols"><%= it.protocols.length === 0 ? '(none)' : it.protocols.join(', ') %></dd>
      </dl>
    </section>

    <section aria-labelledby="org-heading">
      <h2 id="org-heading">Your organization</h2>
      <% if (it.session) { %>
        <dl>
          <dt>Organization</dt>
          <dd id="org-name"><%= it.session.org_name %></dd>
          <% if (it.session.node_id !== null) { %>
            <dt>Node</dt>
            <dd id="node-id"><%= it.session.node_id %></dd>
          <% } %>
          <dt>Accepted runs</dt>
          <dd id="accepted-runs"><%= it.session.accepted_runs %></dd>
          <dt>Last receipt</dt>
          <dd id="last-receipt-id"><%= it.session.last_receipt_id === null ? '(none yet)' : it.session.last_receipt_id %></dd>
        </dl>
        <% if (it.session.kind === 'org') { %>
          <p><a id="org-link" href="/org">Manage nodes and tokens</a></p>
        <% } %>
        <form method="post" action="/console/logout">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
          <button type="submit">Sign out</button>
        </form>
      <% } else { %>
        <p>Sign in with a node token to see your organization's accepted runs and last receipt.</p>
        <% if (it.login_failed) { %>
          <p class="error" id="login-error">That token was not recognized.</p>
        <% } %>
        <form method="post" action="/console/session">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>" />
          <label for="token">Node token</label>
          <input id="token" name="token" type="password" autocomplete="off" required />
          <button type="submit">Sign in</button>
        </form>
        <% if (it.enrollment_enabled) { %>
          <p>Enrolled organization? <a id="console-login-link" href="/console/login">Sign in with your console password</a> to manage nodes and tokens.</p>
        <% } %>
      <% } %>
    </section>

    <footer>
      Member API: <code>/v1/openapi.json</code>. Readiness: <code>/readyz</code>.
    </footer>
  </body>
</html>
