{
  "$comment": "Conformance suite for evidence-envelope v1. Every fixture file in this directory must be listed. `expect` lists {path, rule} issues that a conforming validator must report for an invalid fixture (it may report more).",
  "fixtures": [
    { "file": "run.valid.json", "entity": "Run", "valid": true },
    {
      "file": "run.missing-required-context.json",
      "entity": "Run",
      "valid": false,
      "expect": [{ "path": "/context", "rule": "required" }]
    },
    {
      "file": "run.bad-accounting.json",
      "entity": "Run",
      "valid": false,
      "expect": [{ "path": "/accounting", "rule": "accounting_reconciles" }]
    },
    {
      "file": "run.excluded-without-reason.json",
      "entity": "Run",
      "valid": false,
      "expect": [{ "path": "/exclusion_reason", "rule": "required" }]
    },
    { "file": "receipt.valid.json", "entity": "AnswerReceipt", "valid": true },
    {
      "file": "receipt.released-latency-v1.valid.json",
      "entity": "AnswerReceipt",
      "valid": true
    },
    {
      "file": "receipt.leaks-other-org-run.json",
      "entity": "AnswerReceipt",
      "valid": false,
      "expect": [{ "path": "", "rule": "additionalProperties" }]
    },
    {
      "file": "receipt.leaks-run-in-contradiction.json",
      "entity": "AnswerReceipt",
      "valid": false,
      "expect": [{ "path": "/result/contradictions/0", "rule": "additionalProperties" }]
    },
    { "file": "challenge.valid.json", "entity": "Challenge", "valid": true },
    {
      "file": "challenge.free-text-grounds.json",
      "entity": "Challenge",
      "valid": false,
      "expect": [
        { "path": "/grounds", "rule": "enum" },
        { "path": "/statement", "rule": "additionalProperties" }
      ]
    },
    { "file": "outcome.valid.json", "entity": "Outcome", "valid": true },
    {
      "file": "outcome.observation-rewrites-prediction.json",
      "entity": "Outcome",
      "valid": false,
      "expect": [
        { "path": "/observed/result", "rule": "enum" },
        { "path": "/observed", "rule": "additionalProperties" },
        { "path": "/observed/environment_changed", "rule": "required" }
      ]
    },
    { "file": "prediction.valid.json", "entity": "Prediction", "valid": true },
    { "file": "claim.valid.json", "entity": "Claim", "valid": true },
    {
      "file": "claim.lists-supporting-run-ids.json",
      "entity": "Claim",
      "valid": false,
      "expect": [{ "path": "/supporting_runs", "rule": "type" }]
    },
    { "file": "relationship.valid.json", "entity": "Relationship", "valid": true },
    {
      "file": "relationship.free-text-rationale.json",
      "entity": "Relationship",
      "valid": false,
      "expect": [
        { "path": "/kind", "rule": "enum" },
        { "path": "/rationale", "rule": "enum" }
      ]
    }
  ]
}
