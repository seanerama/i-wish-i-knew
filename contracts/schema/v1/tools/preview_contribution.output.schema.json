{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwik:contracts:v1:tools:preview_contribution:output",
  "title": "preview_contribution output",
  "type": "object",
  "description": "Output envelope of preview_contribution: POST /v1/contributions/preview",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "data"
      ],
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        },
        "data": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "run_id",
            "preview_id",
            "content_digest",
            "expires_at",
            "sanitization",
            "would_store",
            "run"
          ],
          "properties": {
            "run_id": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "ULID identifier",
              "type": "string"
            },
            "preview_id": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "ULID identifier",
              "type": "string"
            },
            "content_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest, `sha256:<hex>`",
              "type": "string"
            },
            "expires_at": {
              "format": "date-time",
              "description": "RFC 3339 UTC timestamp",
              "type": "string"
            },
            "sanitization": {},
            "would_store": {},
            "run": {
              "additionalProperties": false,
              "description": "One execution of one protocol from one node, with honest accounting",
              "if": {
                "properties": {
                  "execution_status": {
                    "const": "excluded"
                  }
                },
                "required": [
                  "execution_status"
                ]
              },
              "then": {
                "required": [
                  "exclusion_reason"
                ]
              },
              "type": "object",
              "required": [
                "run_id",
                "attempt_id",
                "node_id",
                "protocol_ref",
                "protocol_digest",
                "harness_digest",
                "started_at",
                "ended_at",
                "target",
                "execution_status",
                "accounting",
                "context",
                "result",
                "result_schema_digest",
                "artifacts",
                "origin",
                "corroboration",
                "submission"
              ],
              "properties": {
                "run_id": {
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "description": "ULID identifier",
                  "type": "string"
                },
                "attempt_id": {
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "description": "ULID identifier",
                  "type": "string"
                },
                "org_ref": {
                  "minLength": 1,
                  "description": "Set by intake; absent on the wire from the node",
                  "type": "string"
                },
                "node_id": {
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "description": "ULID identifier",
                  "type": "string"
                },
                "protocol_ref": {
                  "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
                  "description": "Protocol reference: <pack>/<protocol>@<major>",
                  "type": "string"
                },
                "protocol_digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "SHA-256 digest, `sha256:<hex>`",
                  "type": "string"
                },
                "harness_digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "SHA-256 digest, `sha256:<hex>`",
                  "type": "string"
                },
                "investigation_id": {
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "description": "ULID identifier",
                  "type": "string"
                },
                "started_at": {
                  "format": "date-time",
                  "description": "RFC 3339 UTC timestamp",
                  "type": "string"
                },
                "ended_at": {
                  "format": "date-time",
                  "description": "RFC 3339 UTC timestamp",
                  "type": "string"
                },
                "target": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "label_digest"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "service",
                        "fixture",
                        "device"
                      ]
                    },
                    "label_digest": {
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "description": "SHA-256 digest, `sha256:<hex>`",
                      "type": "string"
                    }
                  }
                },
                "execution_status": {
                  "type": "string",
                  "enum": [
                    "attempted",
                    "succeeded",
                    "failed",
                    "excluded",
                    "unobserved"
                  ],
                  "description": "`unobserved` means the collector or target was unreachable; it is never a product failure"
                },
                "exclusion_reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "accounting": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "planned",
                    "attempted",
                    "succeeded",
                    "failed",
                    "excluded",
                    "unobserved"
                  ],
                  "properties": {
                    "planned": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "attempted": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "succeeded": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "failed": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "excluded": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "unobserved": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  }
                },
                "context": {
                  "description": "Context profile: list of ContextField",
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "description": "Typed context field with origin and uncertainty",
                    "type": "object",
                    "required": [
                      "key",
                      "value",
                      "origin"
                    ],
                    "properties": {
                      "key": {
                        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                        "description": "Dotted lowercase context key",
                        "type": "string"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "unit": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "measured",
                          "provider_reported",
                          "operator_reported",
                          "unknown"
                        ],
                        "description": "How the value was obtained"
                      },
                      "uncertainty": {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "none",
                              "range",
                              "categorical"
                            ]
                          },
                          "detail": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "result": {
                  "additionalProperties": true,
                  "description": "Validated separately against the pack's result schema",
                  "type": "object",
                  "properties": {}
                },
                "result_schema_digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "SHA-256 digest, `sha256:<hex>`",
                  "type": "string"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "description": "Digest and access policy for an artifact retained in the local vault",
                    "type": "object",
                    "required": [
                      "digest",
                      "kind",
                      "size_bytes",
                      "access"
                    ],
                    "properties": {
                      "digest": {
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "description": "SHA-256 digest, `sha256:<hex>`",
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "attempts",
                          "stdout",
                          "stderr",
                          "harness_output",
                          "file"
                        ],
                        "description": "What the retained artifact is"
                      },
                      "size_bytes": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "media_type": {
                        "type": "string"
                      },
                      "access": {
                        "type": "string",
                        "enum": [
                          "vault_only",
                          "on_request",
                          "cooperative"
                        ],
                        "description": "Access policy: vault_only never leaves the node; on_request is disclosed only to a challenge; cooperative may be shared with the cohort"
                      }
                    }
                  }
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "measured",
                    "reported",
                    "inferred",
                    "published"
                  ]
                },
                "corroboration": {
                  "type": "string",
                  "enum": [
                    "unreplicated",
                    "independently_replicated",
                    "disputed"
                  ]
                },
                "submission": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "signed_at",
                    "key_id",
                    "signature",
                    "sharing_policy"
                  ],
                  "properties": {
                    "signed_at": {
                      "format": "date-time",
                      "description": "RFC 3339 UTC timestamp",
                      "type": "string"
                    },
                    "key_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "signature": {
                      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                      "description": "Standard base64",
                      "type": "string"
                    },
                    "sharing_policy": {
                      "type": "string",
                      "enum": [
                        "private",
                        "cooperative"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false,
          "type": "boolean"
        },
        "error": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Machine-readable code: policy_denied, scope_required, suppressed, insufficient_evidence, validation_failed, not_yet_available, ...",
              "type": "string"
            },
            "message": {
              "description": "Never includes private field values",
              "type": "string"
            },
            "next_step": {
              "description": "Human-actionable text, e.g. the exact CLI command to run",
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
