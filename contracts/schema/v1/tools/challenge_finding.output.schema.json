{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwik:contracts:v1:tools:challenge_finding:output",
  "title": "challenge_finding output",
  "type": "object",
  "description": "Output envelope of challenge_finding: POST /v1/challenges",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "data"
      ],
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        },
        "data": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "challenge_id"
          ],
          "properties": {
            "challenge_id": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "ULID identifier",
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "acknowledged",
                "resolved"
              ]
            },
            "grounds": {
              "type": "string",
              "enum": [
                "method",
                "context_mismatch",
                "data_error",
                "replication_failed",
                "affiliation"
              ],
              "description": "Structured grounds of a challenge (brief §7 \"Challenge handling\")"
            },
            "filed_at": {
              "format": "date-time",
              "description": "RFC 3339 UTC timestamp",
              "type": "string"
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false,
          "type": "boolean"
        },
        "error": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Machine-readable code: policy_denied, scope_required, suppressed, insufficient_evidence, validation_failed, not_yet_available, ...",
              "type": "string"
            },
            "message": {
              "description": "Never includes private field values",
              "type": "string"
            },
            "next_step": {
              "description": "Human-actionable text, e.g. the exact CLI command to run",
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
