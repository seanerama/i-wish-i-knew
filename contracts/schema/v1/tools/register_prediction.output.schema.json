{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwik:contracts:v1:tools:register_prediction:output",
  "title": "register_prediction output",
  "type": "object",
  "description": "Output envelope of register_prediction: POST /v1/outcomes (prediction step)",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "data"
      ],
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        },
        "data": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "prediction_id",
            "registered_at",
            "horizon",
            "evaluation_rule"
          ],
          "properties": {
            "prediction_id": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "ULID identifier",
              "type": "string"
            },
            "registered_at": {
              "format": "date-time",
              "description": "RFC 3339 UTC timestamp",
              "type": "string"
            },
            "horizon": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            "evaluation_rule": {
              "type": "string",
              "enum": [
                "own_measurement",
                "cooperative_requery",
                "operational_observation"
              ],
              "description": "How the outcome will be judged, fixed before it is known"
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false,
          "type": "boolean"
        },
        "error": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Machine-readable code: policy_denied, scope_required, suppressed, insufficient_evidence, validation_failed, not_yet_available, ...",
              "type": "string"
            },
            "message": {
              "description": "Never includes private field values",
              "type": "string"
            },
            "next_step": {
              "description": "Human-actionable text, e.g. the exact CLI command to run",
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
