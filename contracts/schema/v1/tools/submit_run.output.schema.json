{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwik:contracts:v1:tools:submit_run:output",
  "title": "submit_run output",
  "type": "object",
  "description": "Output envelope of submit_run: POST /v1/runs",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "data"
      ],
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        },
        "data": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "run_id",
            "status",
            "receipt"
          ],
          "properties": {
            "run_id": {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "ULID identifier",
              "type": "string"
            },
            "status": {
              "description": "201 accepted, 200 already accepted",
              "type": "integer"
            },
            "receipt": {
              "additionalProperties": true,
              "description": "Intake receipt",
              "type": "object",
              "properties": {}
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false,
          "type": "boolean"
        },
        "error": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Machine-readable code: policy_denied, scope_required, suppressed, insufficient_evidence, validation_failed, not_yet_available, ...",
              "type": "string"
            },
            "message": {
              "description": "Never includes private field values",
              "type": "string"
            },
            "next_step": {
              "description": "Human-actionable text, e.g. the exact CLI command to run",
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
