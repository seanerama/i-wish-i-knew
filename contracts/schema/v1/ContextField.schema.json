{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwik:contracts:v1:ContextField",
  "title": "ContextField",
  "additionalProperties": false,
  "description": "Typed context field with origin and uncertainty",
  "type": "object",
  "required": [
    "key",
    "value",
    "origin"
  ],
  "properties": {
    "key": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Dotted lowercase context key",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "measured",
        "provider_reported",
        "operator_reported",
        "unknown"
      ],
      "description": "How the value was obtained"
    },
    "uncertainty": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "range",
            "categorical"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
